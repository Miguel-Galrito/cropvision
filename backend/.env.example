# SatHealth Backend Environment Variables
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sathealth.vercel.app

# STAC Catalog Settings
STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-l2a
STAC_TIMEOUT_SECONDS=25.0

# Defaults
DEFAULT_MAX_CLOUD_COVER=20.0
DEFAULT_BUFFER_METERS=500.0
